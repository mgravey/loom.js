{
  "name": "@mgravey/loom-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mgravey/loom-agent-codex": "workspace:^",
    "@mgravey/loom-plugin-api": "workspace:^",
    "@mgravey/loom-tool-workspace": "workspace:^",
    "@mgravey/loom-types": "workspace:^"
  },
  "devDependencies": {
    "@mgravey/loom-core": "workspace:^",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
