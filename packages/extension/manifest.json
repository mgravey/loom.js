{
  "manifest_version": 3,
  "name": "Loom Credential Broker (Development)",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "description": "Provider-neutral credential broker for Loom applications.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  }
}
