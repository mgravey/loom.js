{
  "name": "@mgravey/loom-extension-codex-experimental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/service-worker.js",
    "./dist/brand-animation.js",
    "./dist/options.js",
    "./dist/callback.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "options.html",
    "privacy.html",
    "THIRD_PARTY_NOTICES.txt",
    "icons"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json && tsup --config tsup.extension.config.ts && cp manifest.json options.html callback.html privacy.html THIRD_PARTY_NOTICES.txt dist/ && rm -rf dist/icons && cp -R icons dist/icons",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/extension-codex-experimental/test"
  },
  "dependencies": {
    "@mgravey/loom-auth-codex-experimental": "workspace:^",
    "@mgravey/loom-credential-provider-api": "workspace:^",
    "@mgravey/loom-extension": "workspace:^",
    "lottie-web": "5.13.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
