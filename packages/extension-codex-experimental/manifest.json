{
  "manifest_version": 3,
  "name": "Loom Secure Model Bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Authenticates Loom sessions and relays model requests only when direct browser access fails.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "not_allowed",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": [
    "http://localhost:1455/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/backend-api/codex/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["callback.html"],
      "matches": ["http://localhost:1455/*", "https://auth.openai.com/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  }
}
