{
  "name": "@mgravey/loom-credential-broker-api",
  "version": "0.1.0",
  "description": "Transport-neutral validated credential request and response protocol for Loom.js hosts and extensions.",
  "license": "MPL-2.0",
  "author": "Mathieu Gravey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgravey/loom.js.git",
    "directory": "packages/credential-broker-api"
  },
  "homepage": "https://mgravey.com/loom.js/",
  "bugs": {
    "url": "https://github.com/mgravey/loom.js/issues"
  },
  "keywords": [
    "loom",
    "credentials",
    "browser-extension",
    "protocol",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "prepack": "pnpm run build && node ../../scripts/prepare-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
