{
  "name": "@loom/examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loom/agent-codex": "workspace:*",
    "@loom/plugin-api": "workspace:*",
    "@loom/tool-workspace": "workspace:*",
    "@loom/types": "workspace:*"
  },
  "devDependencies": {
    "@loom/core": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
