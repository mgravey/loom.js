{
  "name": "@mgravey/loom-companion-codex-experimental",
  "version": "0.2.1",
  "description": "Experimental website client for routing Loom Codex model requests through the Loom.js Companion Chrome extension.",
  "license": "MPL-2.0",
  "author": "Mathieu Gravey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgravey/loom.js.git",
    "directory": "packages/companion-codex-experimental"
  },
  "homepage": "https://mgravey.com/loom.js/",
  "bugs": {
    "url": "https://github.com/mgravey/loom.js/issues"
  },
  "keywords": [
    "loom",
    "chrome-extension",
    "codex",
    "model-transport",
    "experimental"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "prepack": "pnpm run build && node ../../scripts/prepare-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/companion-codex-experimental/test"
  },
  "dependencies": {
    "@mgravey/loom-auth-extension": "workspace:^",
    "@mgravey/loom-model-codex-experimental": "workspace:^",
    "@mgravey/loom-plugin-api": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
