{
  "manifest_version": 3,
  "name": "Loom.js Companion",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "description": "Connects approved Loom websites to ChatGPT and custom Responses servers with extension-managed credentials.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Loom.js Companion"
  },
  "incognito": "not_allowed",
  "permissions": ["declarativeNetRequest", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "http://localhost:1455/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/backend-api/codex/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["callback.html"],
      "matches": ["http://localhost:1455/*", "https://auth.openai.com/*"]
    },
    {
      "resources": ["chatgpt-callback.html"],
      "matches": ["http://127.0.0.1/*", "https://auth.openai.com/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
  }
}
